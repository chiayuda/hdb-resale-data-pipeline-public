<mxCell id="gotcha" value="&lt;b&gt;Important:&lt;/b&gt; Athena accesses S3 through the AWS-managed backend. Do not require Athena-originated bucket requests to carry Tableau's VPC endpoint ID." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#334155;fillColor=#FFF7ED;strokeColor=#FDBA74;spacing=6;rounded=1;" vertex="1" parent="1"><mxGeometry x="1646" y="747" width="462" height="150" as="geometry" /></mxCell>
