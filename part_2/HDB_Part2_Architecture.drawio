<mxCell id="sec" value="&lt;b&gt;ACCESS CONTROLS&lt;/b&gt;&lt;br/&gt;&#8226; Athena workgroup IAM policies&lt;br/&gt;&#8226; Curated query + results-bucket permissions&lt;br/&gt;&#8226; Encrypted query-results bucket&lt;br/&gt;&#8226; S3 and Athena endpoint policies&lt;br/&gt;&#8226; Enable CloudTrail S3 data events for object audit&lt;br/&gt;&#8226; Private corporate user access to Tableau; no VPC peering" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#334155;fillColor=#EDF4FF;strokeColor=#B6CFEC;spacing=6;rounded=1;" vertex="1" parent="1"><mxGeometry x="63" y="753" width="811" height="241" as="geometry" /></mxCell>
